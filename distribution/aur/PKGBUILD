# Maintainer: OnlyXianzo <xianzo.help@gmail.com>
pkgname=grablytic-bin
pkgver=0.0.2
pkgrel=1
pkgdesc="Privacy-first high-performance media downloader powered by yt-dlp"
arch=('x86_64' 'aarch64')
url="https://github.com/OnlyXianzo/Grablytic"
license=('GPL3')
depends=('gtk3' 'python' 'ffmpeg' 'aria2')
provides=('grablytic')
conflicts=('grablytic' 'truestream' 'truestream-bin')
replaces=('truestream-bin')

source_x86_64=("https://github.com/OnlyXianzo/Grablytic/releases/download/v${pkgver}/grablytic-${pkgver}-linux-x64.tar.gz")
source_aarch64=("https://github.com/OnlyXianzo/Grablytic/releases/download/v${pkgver}/grablytic-${pkgver}-linux-arm64.tar.gz")
source=('grablytic.desktop' 'grablytic.png')

# Sums verified against the v0.0.2 GitHub release assets.
sha256sums_x86_64=('f7d2b31876574637ad7e9c21598c39a8db8811484f77cf1a1425b4e6f928b9f7')
sha256sums_aarch64=('eb81d8a69d485428f16e120a20ec7283e11e92d107035d62580843ac27cf299e')
sha256sums=('SKIP' 'SKIP')

package() {
    install -d "${pkgdir}/opt/grablytic"
    cp -r "${srcdir}"/* "${pkgdir}/opt/grablytic/"
    rm -f "${pkgdir}/opt/grablytic"/*.tar.gz
    rm -f "${pkgdir}/opt/grablytic"/grablytic.desktop "${pkgdir}/opt/grablytic"/grablytic.png

    install -d "${pkgdir}/usr/bin"
    ln -s /opt/grablytic/grablytic "${pkgdir}/usr/bin/grablytic"

    install -Dm644 "${srcdir}/grablytic.desktop" "${pkgdir}/usr/share/applications/grablytic.desktop"
    install -Dm644 "${srcdir}/grablytic.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/grablytic.png"
}
