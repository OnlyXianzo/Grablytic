<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / transfer exclusions (SEC-01). Cookies, auth prefs, history DB
     and logs must never leave the device via cloud backup or D2D transfer.
     See https://developer.android.com/identity/data/autobackup -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="file" path="logs/" />
    </device-transfer>
</data-extraction-rules>
