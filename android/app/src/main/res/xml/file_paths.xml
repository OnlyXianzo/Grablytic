<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider roots for opening downloaded media in the system player.

     `external-path` covers the whole of shared storage, and it has to: the
     download folder is chosen at runtime (`FilePicker.getDirectoryPath()` in
     Settings → Download folder), so no build-time root can contain every file
     the app legitimately serves. What may be shared is therefore decided at
     the sink — `intent/open_file` canonicalises the path and refuses anything
     outside `output_dir` (DownloadPathGuard, SEC-004).

     The app-private roots cover the internal download folder that
     `/Internal/Videos` maps to. The cache roots were removed: nothing the app
     opens through the provider lives in a cache directory, so they only
     widened the set of files a future path-confusion bug could reach. -->
<paths>
    <external-path name="external_files" path="." />
    <external-files-path name="external_app_files" path="." />
    <files-path name="internal_files" path="." />
</paths>
